@using Assignment1_MVC.Models

<h1>Equipment List Available or Not Available</h1>

<table class="table table-light table-group-divider">

    <thread>
    <tr>
        <th>Id</th>
        <th>Status</th>
        <th>Equipment</th>
<th>Description</th>
    </tr>
    </thread>
<tbody>
        @foreach (Form.EquipmentType item in Enum.GetValues(typeof(Form.EquipmentType)))
        {
            <tr>
                <td>@((int)item)</td>
                <td>
                    <span class="badge bg-success">Available</span>
                </td>
                <td>@item</td>

                <td class="text-muted">@item.GetDisplayName()</td>
            </tr>
        }
        
</tbody>

</table>